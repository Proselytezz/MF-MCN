# 数据（BraTS 原始/预处理 h5，约 140GB）
# 默认忽略，按批次用 `git add -f <目录>` 显式加入（已由 .gitattributes 走 LFS）
data/

# 模型权重与检查点
*.pth
*.pt
*.ckpt
*.h5

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# 运行时产物
outputs/**/predictions/
.screenshots/

# 系统/编辑器
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
